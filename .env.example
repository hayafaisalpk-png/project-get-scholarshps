# ---------------------------------------------------------------------------
# GetScholarship — environment variable template
#
# Copy to `.env.local` and fill in real values.
#
# SECURITY RULES
#   * Only variables prefixed with NEXT_PUBLIC_ are sent to the browser.
#   * NEVER prefix a secret with NEXT_PUBLIC_.
#   * The Supabase service-role / secret key MUST NOT be exposed to the browser
#     and MUST NOT be stored in any public CMS setting.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL from Supabase Dashboard > Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (formerly "anon") key. Safe for browser use ONLY because RLS
# policies enforce authorization. Newer projects issue `sb_publishable_...` keys;
# older projects still use the legacy JWT anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --- Supabase service role (server only — NEVER expose to the client) ------
# Used for privileged server-side operations (audit logging, scheduled
# publishing, administrative reads that must bypass RLS).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# --- Site ------------------------------------------------------------------
# Canonical origin. No trailing slash. Used for canonical URLs, sitemap,
# robots.txt, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Analytics 4 (optional) ----------------------------------------
# Leave empty to disable analytics entirely (analytics is also consent-gated).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google AdSense (optional) ---------------------------------------------
# Publisher ID, e.g. ca-pub-0000000000000000. Leave empty in development to
# guarantee no test ad traffic touches a real AdSense account.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# --- Email / transactional -------------------------------------------------
# Supabase Auth email delivery. Configure the SMTP provider in the Supabase
# dashboard; these values are only needed if sending mail server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=GetScholarship <no-reply@getscholarship.online>

# --- Security --------------------------------------------------------------
# Used to validate server action / route handler origins (CSRF defence).
# Must match the canonical origin exactly.
APP_ORIGIN=http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
# Upstash Redis is optional. Without it, an in-memory limiter is used, which is
# per-instance and therefore weaker on serverless. Strongly recommended in
# production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Seeding (development only) --------------------------------------------
# Used by `npm run seed` to create the first super administrator. Never set in
# production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
